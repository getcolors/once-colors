# direnv configuration for this ONCE deployment.
#
# This file is safe to commit: it contains NO secret values.
# Every credential lives in .envrc.private, which is gitignored.
# Run `direnv allow` once to activate.

# The local OCI DEFAULT profile is session-token based (it has
# security_token_file but no `user` key), so the oci CLI rejects it under
# the default ApiKey auth. This makes plain `oci ...` calls work.
#
# This is for the CLI ONLY. The OpenTofu oracle/oci provider detects
# security_token_file by itself and authenticates without this variable —
# verified with a real `tofu plan`. Do not treat it as required by green.
export OCI_CLI_AUTH=security_token

# Load COLORS_PAR_* credentials if the private file is present.
# Nothing here fails when it is missing, so `build` and `create --dry-run`
# still work on a fresh checkout.
source_env_if_exists .envrc.private
